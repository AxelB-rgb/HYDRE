# --- Mongo (inchangé) ---
MONGO_URI=mongodb://localhost:27017/

# --- Authentification MASTER / VIEWER ---
# 🔒 Secret MASTER : c'est l'ancien mot de passe (auparavant REACT_APP_MOT_DE_PASSE_MAITRE
# côté frontend + comparé en clair côté backend). Il garde tous les droits.
API_SECRET_KEY=change-moi-en-un-secret-fort

# 🆕 Secret VIEWER : nouveau mot de passe à donner à tes amis (lecture seule uniquement).
API_VIEWER_KEY=change-moi-aussi

# 🆕 Secret de signature des tokens de session (HMAC). Optionnel : si absent,
# API_SECRET_KEY est réutilisé pour ne rien casser, mais il est recommandé d'en
# définir un dédié.
API_TOKEN_SECRET=change-moi-encore
